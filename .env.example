DATABASE_URL=postgres://knowledgeos:knowledgeos@localhost:5432/knowledgeos
KNOWLEDGEOS_API_PORT=4100
DEFAULT_WORKSPACE_NAME=Default

# Use fixture for local development without keys.
# Set LLM_PROVIDER=groq and GROQ_API_KEY for Groq-backed extraction.
LLM_PROVIDER=fixture
GROQ_API_KEY=
GROQ_CHAT_MODEL=openai/gpt-oss-20b

EMBEDDING_PROVIDER=deterministic
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
