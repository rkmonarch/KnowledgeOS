{
  "name": "knowledgeos",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@8.12.1",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel --filter=@knowledgeos/web --filter=@knowledgeos/worker",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:unit": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx packages/database/src/migrate.ts",
    "db:push": "drizzle-kit push"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^2.1.8",
    "drizzle-kit": "^0.30.1",
    "tsx": "^4.19.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
